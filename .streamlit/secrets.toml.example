# Streamlit secrets 範本
#
# 本機開發：複製此檔為 .streamlit/secrets.toml 並填入密碼
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 若本機不設密碼，程式會以「開發模式」直接放行（側邊欄會顯示提示）。
#
# 雲端部署（Streamlit Community Cloud）：
#   在 App settings → Secrets 貼上以下內容（不要用檔案上傳）
#
# 重要：secrets.toml 已在 .gitignore 中，不會進版控。

APP_PASSWORD = "請改成你的密碼"
